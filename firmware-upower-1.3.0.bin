EOEULA

    echo -n "Do you accept the EULA you just read? (y/N) "
    read REPLY
    if [ "$REPLY" != "y" ] && [ "$REPLY" != "Y" ]; then
        echo "EULA has not been accepted. Exiting..."
        exit 1
    fi

    echo "EULA has been accepted. The files will be unpacked at '$targetdir'"
    echo
else
    echo "WARNING: EULA has been auto-accepted; this implies that you agree with it."
fi

echo -n "Unpacking file "
mkdir "$targetdir"
offset=`head -n 803 "$0" | wc -c | tr -d " "`
for s in $filesizes; do
    if _dd "$0" $offset $s | eval "bzip2 -d" | _unpack x | _progress; then
        echo " done"
    else
        _error "Package is corrupted. Exiting..."
    fi
    offset=`expr $offset + $s`
done

exit 0
